# --- Sitio ---

# URL pública del sitio (sin barra final). Se usa en metadata, sitemap, OG y JSON-LD.
NEXT_PUBLIC_SITE_URL=https://gonzhaga.com

# --- Contacto / WhatsApp ---

# Número de WhatsApp en formato internacional, sin "+" ni espacios.
# Ejemplo Colombia: 57 + número de 10 dígitos.
NEXT_PUBLIC_WHATSAPP=573244483045

# --- Envío del formulario (Resend) ---

# API key de Resend (https://resend.com/api-keys).
RESEND_API_KEY=re_tu_api_key

# Correo que RECIBE los mensajes del formulario.
CONTACT_EMAIL=brandon.velasquez.osorio@gmail.com

# Remitente de los correos. Debe usar un dominio verificado en Resend.
# Para pruebas puedes usar el remitente de Resend (solo envía a tu propio correo):
#   CONTACT_FROM="Gonzhaga <onboarding@resend.dev>"
# En producción, con tu dominio verificado:
#   CONTACT_FROM="Gonzhaga <contacto@gonzhaga.com>"
CONTACT_FROM="Gonzhaga <onboarding@resend.dev>"
